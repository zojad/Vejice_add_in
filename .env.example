# Safe defaults: no document text leaves the add-in unless you explicitly opt in.

# Correction service
VEJICE_CORRECTION_PROVIDER=mock
VEJICE_REMOTE_CORRECTION_TRUSTED=false
VEJICE_ALLOW_UNSAFE_REMOTE_API=false
VEJICE_API_URL=https://127.0.0.1:4001/api/postavi_vejice
VEJICE_API_KEY=

# Lemmatizer / anchoring
VEJICE_LEMMATIZER_PROVIDER=synthetic
VEJICE_REMOTE_LEMMATIZER_TRUSTED=false
VEJICE_ALLOW_UNSAFE_LEMMATIZER=false
VEJICE_LEMMAS_URL=https://127.0.0.1:4001/lemmas
VEJICE_LEMMAS_TIMEOUT_MS=15000

# Legacy compatibility toggles (keep for older flows)
VEJICE_USE_MOCK=true
VEJICE_USE_LEMMATIZER=false
VEJICE_LEMMATIZER_ANCHORS=false

# Logging / runtime tuning
VEJICE_QUIET_LOGS=false
VEJICE_ERROR_LOGS=true
VEJICE_ONLINE_VERBOSE_LOGS=false
VEJICE_ONLINE_DRIFT_LOGS=false
VEJICE_DEBUG=false
VEJICE_VERBOSE_LOGS=false
VEJICE_DESKTOP_VERBOSE_LOGS=false
VEJICE_QUOTE_TRACE_VERBOSE=false
VEJICE_API_TIMEOUT_MS=45000
VEJICE_ONLINE_CHECK_TIMEOUT_MS=600000
VEJICE_ONLINE_PARAGRAPH_TIMEOUT_MS=120000
VEJICE_CHECK_RUN_WATCHDOG_MS=600000
VEJICE_CHECK_MAX_PARTIAL_PASSES=1200
VEJICE_CHECK_MAX_REPEATED_PROGRESS=40

# Local proxy config. Leave targets empty until you have a service you trust.
LEMMAS_PROXY_PORT=5050
LEMMAS_PROXY_TARGET_URL=
LEMMAS_PROXY_TARGET_API_KEY=
LEMMAS_PROXY_TARGET_API_KEY_HEADER=X-API-KEY
LEMMAS_PROXY_SHARED_TOKEN=
LEMMAS_PROXY_SHARED_TOKEN_HEADER=x-lemmas-token
LEMMAS_PROXY_TIMEOUT_MS=30000
LEMMAS_PROXY_BODY_LIMIT_BYTES=262144
LEMMAS_PROXY_ALLOWED_ORIGINS=https://127.0.0.1:4001,https://localhost:4001
LEMMAS_PROXY_SSL_KEY_PATH=
LEMMAS_PROXY_SSL_CERT_PATH=

VEJICE_PROXY_PORT=5051
VEJICE_PROXY_TARGET_URL=
VEJICE_PROXY_TARGET_API_KEY=
VEJICE_PROXY_TIMEOUT_MS=30000
VEJICE_PROXY_BODY_LIMIT_BYTES=262144
VEJICE_PROXY_ALLOWED_ORIGINS=https://127.0.0.1:4001,https://localhost:4001
VEJICE_PROXY_SSL_KEY_PATH=
VEJICE_PROXY_SSL_CERT_PATH=

# Trusted internal API example:
# VEJICE_CORRECTION_PROVIDER=remote
# VEJICE_REMOTE_CORRECTION_TRUSTED=true
# VEJICE_API_URL=https://your-domain.example/api/postavi_vejice
#
# Unsafe legacy API opt-in:
# VEJICE_CORRECTION_PROVIDER=remote
# VEJICE_ALLOW_UNSAFE_REMOTE_API=true
# VEJICE_API_KEY=replace-me
#
# Trusted internal lemmatizer example:
# VEJICE_LEMMATIZER_PROVIDER=remote
# VEJICE_REMOTE_LEMMATIZER_TRUSTED=true
# VEJICE_LEMMAS_URL=https://your-domain.example/lemmas
#
# Unsafe legacy lemmatizer opt-in:
# VEJICE_LEMMATIZER_PROVIDER=remote
# VEJICE_ALLOW_UNSAFE_LEMMATIZER=true
